# Copy this file to .env and change the value before running.
# This key is intentionally a single, static, shared secret — that's
# the anti-pattern this exercise is meant to illustrate.
API_KEY=supersecret-demo-key-123

# LDAP — connection to the OpenLDAP container.
# Start LDAP first:  cd ../ldap && docker compose up -d
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
